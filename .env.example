# Copy to .env and fill in whichever provider(s) you use.
# .env is gitignored. Never commit a real key.

# Groq  -> https://console.groq.com/keys        (free tier, default provider)
GROQ_API_KEY=

# Google Gemini -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
